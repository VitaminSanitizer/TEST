---
import { site } from '../content/site';
const { hero } = site;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__inner container">
    <h1 class="hero__name" id="hero-name">{hero.name}</h1>
    <span class="hero__rule" aria-hidden="true"></span>
    <p class="hero__tagline">{hero.tagline}</p>
    <a class="button" href="#interest">{hero.button}</a>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: 6rem;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__name {
    font-size: clamp(3rem, 10vw, 6.5rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .hero__rule {
    display: block;
    width: 3.5rem;
    height: 1px;
    background: var(--accent);
    margin-block: clamp(1.75rem, 4vw, 2.5rem);
  }
  .hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.3rem, 2.8vw, 1.75rem);
    line-height: 1.4;
    color: var(--muted);
    max-width: 30ch;
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }
</style>
